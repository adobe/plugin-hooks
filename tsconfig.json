{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "es2020",
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "node",
    "module": "esnext"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}